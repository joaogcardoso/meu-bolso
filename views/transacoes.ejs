<!DOCTYPE html>
<html lang="pt-BR">
<%- include('partials/head') %>
<body>
  <%- include('partials/header') %>

  <main>
    <section>
      <p class="eyebrow">Lançamentos</p>
      <h1>Transações</h1>
      <p>
        Adicione, edite, remova e busque seus lançamentos. Tudo é salvo
        automaticamente no <code>localStorage</code> do seu navegador — feche a
        aba e, ao voltar, seus dados continuam aqui.
      </p>
    </section>

    <section>
      <h2 id="titulo-formulario">Novo lançamento</h2>
      <form class="formulario" id="form-transacao">
        <input type="hidden" id="transacao-id" value="" />

        <div class="formulario__linha">
          <div class="campo">
            <label for="campo-data">Data</label>
            <input type="date" id="campo-data" name="data" value="<%= hoje %>" required />
          </div>

          <div class="campo">
            <label for="campo-tipo">Tipo</label>
            <select id="campo-tipo" name="tipo" required>
              <option value="despesa">Despesa</option>
              <option value="receita">Receita</option>
            </select>
          </div>

          <div class="campo">
            <label for="campo-valor">Valor (R$)</label>
            <input type="number" id="campo-valor" name="valor" min="0" step="0.01" placeholder="0,00" required />
          </div>
        </div>

        <div class="formulario__linha">
          <div class="campo">
            <label for="campo-descricao">Descrição</label>
            <input type="text" id="campo-descricao" name="descricao" placeholder="Ex.: Supermercado do mês" required />
          </div>

          <div class="campo">
            <label for="campo-categoria">Categoria</label>
            <select id="campo-categoria" name="categoria" required>
              <% categorias.forEach(function(cat) { %>
                <option value="<%= cat.id %>"><%= cat.icone %> <%= cat.nome %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="formulario__acoes">
          <button type="submit" class="btn btn--ouro" id="btn-salvar">Adicionar</button>
          <button type="button" class="btn btn--linha" id="btn-cancelar-edicao" hidden>Cancelar edição</button>
        </div>
      </form>
    </section>

    <section>
      <h2>Seus lançamentos</h2>

      <div class="busca">
        <input type="search" id="campo-busca" placeholder="Buscar por descrição ou categoria…" aria-label="Buscar transações" />
      </div>

      <div class="razao">
        <div class="razao__cabecalho">
          <span>Livro-razão</span>
          <span class="razao__saldo">Saldo: <span id="razao-saldo">R$ 0,00</span></span>
        </div>
        <table class="tabela">
          <thead>
            <tr>
              <th>Data</th>
              <th>Descrição</th>
              <th>Categoria</th>
              <th>Tipo</th>
              <th>Valor</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody id="corpo-transacoes"></tbody>
        </table>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/transacoes.js"></script>
  </body>
</html>
