<!DOCTYPE html>
<html lang="pt-BR">
<%- include('partials/head') %>
<body>
  <%- include('partials/header') %>

  <main>
    <section>
      <p class="eyebrow">Organização</p>
      <h1>Categorias</h1>
      <p>
        Categorias ajudam a entender para onde o dinheiro vai. Esta lista é
        renderizada pelo próprio servidor Express a partir de um arquivo JSON —
        repare como receitas e despesas recebem cores diferentes automaticamente.
      </p>
    </section>

    <section>
      <div class="grade-categorias">
        <% categorias.forEach(function(cat) { %>
          <div class="categoria-card">
            <p class="categoria-card__icone"><%= cat.icone %></p>
            <h3><%= cat.nome %></h3>
            <% if (cat.tipo === "receita") { %>
              <span class="selo selo--receita">Receita</span>
            <% } else { %>
              <span class="selo selo--despesa">Despesa</span>
            <% } %>
            <p><%= cat.descricao %></p>
          </div>
        <% }) %>
      </div>
    </section>

    <section>
      <h2>Sugerir uma nova categoria</h2>
      <p>Sentiu falta de alguma categoria? Sugira abaixo — a lista de sugestões fica guardada enquanto o servidor estiver no ar.</p>

      <% if (typeof enviado !== "undefined" && enviado) { %>
        <p class="alerta alerta--sucesso">Sugestão recebida, obrigado! Confira a lista logo abaixo.</p>
      <% } %>

      <% if (typeof erro !== "undefined" && erro) { %>
        <p class="alerta alerta--erro"><%= erro %></p>
      <% } %>

      <form class="formulario" action="/categorias" method="POST">
        <div class="formulario__linha">
          <div class="campo">
            <label for="sugestao-nome">Nome da categoria</label>
            <input
              type="text"
              id="sugestao-nome"
              name="nome"
              placeholder="Ex.: Pets"
              value="<%= valoresAntigos && valoresAntigos.nome ? valoresAntigos.nome : '' %>"
              required
            />
          </div>
          <div class="campo">
            <label for="sugestao-tipo">Tipo</label>
            <select id="sugestao-tipo" name="tipo" required>
              <option value="despesa" <%= valoresAntigos && valoresAntigos.tipo === "despesa" ? "selected" : "" %>>Despesa</option>
              <option value="receita" <%= valoresAntigos && valoresAntigos.tipo === "receita" ? "selected" : "" %>>Receita</option>
            </select>
          </div>
        </div>
        <div class="formulario__acoes">
          <button type="submit" class="btn btn--ouro">Enviar sugestão</button>
        </div>
      </form>

      <% if (sugestoes && sugestoes.length > 0) { %>
        <table class="tabela-simples">
          <thead>
            <tr><th>Nome sugerido</th><th>Tipo</th></tr>
          </thead>
          <tbody>
            <% sugestoes.forEach(function(s) { %>
              <tr>
                <td><%= s.nome %></td>
                <td><%= s.tipo === "receita" ? "Receita" : "Despesa" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="alerta alerta--vazio">Nenhuma sugestão enviada ainda nesta sessão do servidor.</p>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>
  </body>
</html>
