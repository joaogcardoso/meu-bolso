{
  "name": "meu-bolso",
  "version": "1.0.0",
  "description": "Aplicação acadêmica de controle financeiro pessoal com Express.js, EJS e persistência simulada no localStorage.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./src/public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./src/public/css/app.css --watch",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "express",
    "ejs",
    "localstorage",
    "financas",
    "academico"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.22.2",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@tailwindcss/typography": "^0.5.16",
    "@vitest/coverage-v8": "^3.2.4",
    "daisyui": "^4.12.24",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2",
    "supertest": "^7.1.3",
    "tailwindcss": "^3.4.17",
    "vitest": "^3.2.4"
  }
}
