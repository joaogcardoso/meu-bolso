<section class="grid gap-4">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-primary">Carteira simulada</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Transações</h1>
    <p class="mt-3 max-w-3xl text-base-content/70">
      O CRUD acontece no navegador e usa um schema versionado no <code class="rounded bg-base-300 px-1">localStorage</code>.
    </p>
  </div>

  <% if (categoryStatus && categoryStatus.hasError) { %>
    <div class="alert alert-warning" role="alert">
      <span><%= categoryStatus.message %> O formulário ficará limitado até o arquivo ser corrigido.</span>
    </div>
  <% } %>
</section>

<section class="mt-8 grid gap-6 lg:grid-cols-[380px_1fr]">
  <form class="card border border-base-300 bg-base-100 shadow-sm" id="transaction-form" action="/transacoes" method="get" novalidate>
    <div class="card-body gap-4">
      <div>
        <h2 class="card-title" id="transaction-form-title">Novo lançamento</h2>
        <p class="text-sm text-base-content/70">Informe os dados financeiros simulados.</p>
      </div>

      <input type="hidden" id="transaction-id" name="id" />

      <div class="form-control">
        <label class="label" for="transaction-type">
          <span class="label-text font-medium">Tipo</span>
        </label>
        <select class="select select-bordered" id="transaction-type" name="type" required>
          <option value="expense">Despesa</option>
          <option value="income">Receita</option>
        </select>
        <p class="mt-1 hidden text-sm text-error" id="transaction-type-error"></p>
      </div>

      <div class="form-control">
        <label class="label" for="transaction-description">
          <span class="label-text font-medium">Descrição</span>
        </label>
        <input class="input input-bordered" id="transaction-description" name="description" type="text" maxlength="80" required />
        <p class="mt-1 hidden text-sm text-error" id="transaction-description-error"></p>
      </div>

      <div class="form-control">
        <label class="label" for="transaction-category">
          <span class="label-text font-medium">Categoria</span>
        </label>
        <select class="select select-bordered" id="transaction-category" name="categoryId" required>
          <% categories.forEach(function(category) { %>
            <option value="<%= category.id %>"><%= category.name %></option>
          <% }) %>
        </select>
        <p class="mt-1 hidden text-sm text-error" id="transaction-category-error"></p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        <div class="form-control">
          <label class="label" for="transaction-amount">
            <span class="label-text font-medium">Valor</span>
          </label>
          <input class="input input-bordered" id="transaction-amount" name="amount" type="number" min="0.01" step="0.01" placeholder="0,00" required />
          <p class="mt-1 hidden text-sm text-error" id="transaction-amount-error"></p>
        </div>

        <div class="form-control">
          <label class="label" for="transaction-date">
            <span class="label-text font-medium">Data</span>
          </label>
          <input class="input input-bordered" id="transaction-date" name="occurredOn" type="date" value="<%= today %>" required />
          <p class="mt-1 hidden text-sm text-error" id="transaction-date-error"></p>
        </div>
      </div>

      <div class="card-actions mt-2">
        <button class="btn btn-primary" id="transaction-submit" type="submit">Adicionar</button>
        <button class="btn btn-ghost hidden" id="transaction-cancel" type="button">Cancelar edição</button>
      </div>
    </div>
  </form>

  <div class="grid gap-6">
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="stat rounded-box border border-base-300 bg-base-100">
        <div class="stat-title">Saldo</div>
        <div class="stat-value text-2xl" id="summary-balance">R$ 0,00</div>
      </div>
      <div class="stat rounded-box border border-success/20 bg-success/10">
        <div class="stat-title">Receitas</div>
        <div class="stat-value text-2xl text-success" id="summary-income">R$ 0,00</div>
      </div>
      <div class="stat rounded-box border border-error/20 bg-error/10">
        <div class="stat-title">Despesas</div>
        <div class="stat-value text-2xl text-error" id="summary-expense">R$ 0,00</div>
      </div>
    </div>

    <div class="rounded-box border border-base-300 bg-base-100 p-4">
      <div class="grid gap-3 md:grid-cols-[1fr_180px_180px]">
        <label class="form-control">
          <span class="label-text mb-1 font-medium">Buscar</span>
          <input class="input input-bordered" id="transaction-search" type="search" placeholder="Descrição ou categoria" />
        </label>
        <label class="form-control">
          <span class="label-text mb-1 font-medium">Tipo</span>
          <select class="select select-bordered" id="transaction-filter-type">
            <option value="all">Todos</option>
            <option value="income">Receitas</option>
            <option value="expense">Despesas</option>
          </select>
        </label>
        <label class="form-control">
          <span class="label-text mb-1 font-medium">Ordenação</span>
          <select class="select select-bordered" id="transaction-sort">
            <option value="date-desc">Data mais recente</option>
            <option value="date-asc">Data mais antiga</option>
            <option value="amount-desc">Maior valor</option>
            <option value="amount-asc">Menor valor</option>
          </select>
        </label>
      </div>
    </div>

    <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
      <table class="table">
        <caption class="sr-only">Transações registradas no navegador</caption>
        <thead>
          <tr>
            <th>Data</th>
            <th>Descrição</th>
            <th>Categoria</th>
            <th>Tipo</th>
            <th class="text-right">Valor</th>
            <th class="text-right">Ações</th>
          </tr>
        </thead>
        <tbody id="transactions-table-body"></tbody>
      </table>
    </div>
  </div>
</section>

<div class="toast toast-end z-30" aria-live="polite" aria-atomic="true" id="transaction-feedback"></div>

<dialog class="modal" id="delete-transaction-modal" aria-labelledby="delete-transaction-title">
  <div class="modal-box">
    <h2 class="text-lg font-semibold" id="delete-transaction-title">Excluir transação</h2>
    <p class="mt-2 text-base-content/70">Esta ação remove o lançamento do armazenamento local deste navegador.</p>
    <div class="modal-action">
      <button class="btn btn-ghost" id="delete-cancel" type="button">Cancelar</button>
      <button class="btn btn-error" id="delete-confirm" type="button">Excluir</button>
    </div>
  </div>
</dialog>

<script src="/js/pages/transactions.js" defer></script>
